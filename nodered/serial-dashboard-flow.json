  {
    "id": "toggle_serial_node",
    "type": "function",
    "z": "f1a2b3c4",
    "name": "Toggle serial_in disabled",
    "func": "const action = msg.payload;\nconst flows = Array.isArray(msg.payload) ? msg.payload : (msg.payload.flows || []);\nconst rev = msg.payload.revision;\nlet found = false;\nconst updated = flows.map(n => {\n    if (n.id === 'serial_in') {\n        found = true;\n        return Object.assign({}, n, { disabled: (action === 'stop') });\n    }\n    return n;\n});\nif (!found) return { payload: 'serial_in node not found' };\nreturn { payload: { flows: updated, revision: rev }, headers: { 'Content-Type': 'application/json', 'Node-RED-Deployment-Type': 'nodes' } };",
    "outputs": 1,
    "noerr": 0,
