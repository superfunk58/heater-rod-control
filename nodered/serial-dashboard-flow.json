    "func": "const flows = Array.isArray(msg.payload) ? msg.payload : (msg.payload.flows || []);\nconst rev = msg.payload.revision;\nconst updated = flows.map(n => {\n    if (n.id === 'serial_in') return Object.assign({}, n, { disabled: true });\n    return n;\n});\nreturn { payload: { flows: updated, revision: rev }, headers: { 'Content-Type': 'application/json', 'Node-RED-Deployment-Type': 'nodes' } };",
